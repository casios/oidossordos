// apps/api/prisma/schema.prisma
// Derivado de /docs/schema.sql — misma fuente de verdad, traducida a Prisma DSL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum UserRole {
  usuario
  moderador
  administrador
}

enum ModerationStatus {
  pendiente
  aprobado
  rechazado
}

enum ContentSourceType {
  etl
  manual
}

enum EventType {
  concierto
  festival
}

enum ExternalSource {
  metal_archives
  metal_storm
  bandsintown
  musicbrainz
  setlist_fm
}

enum ReminderChannel {
  email
  push
}

enum ModerationEntityType {
  band
  venue
  event
}

enum ModerationAction {
  aprobado
  rechazado
  cambios_solicitados
}

enum EtlRunStatus {
  success
  failed
  partial
}

enum AuthTokenType {
  email_verification
  password_reset
}

// ---------------------------------------------------------
// USUARIOS Y AUTENTICACIÓN
// ---------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  emailVerified          Boolean   @default(false) @map("email_verified")
  passwordHash           String?   @map("password_hash")
  oauthProvider          String?   @map("oauth_provider")
  oauthId                String?   @map("oauth_id")
  displayName            String    @map("display_name")
  avatarUrl              String?   @map("avatar_url")
  role                   UserRole  @default(usuario)
  isActive               Boolean   @default(true) @map("is_active")
  notificationsPausedAt  DateTime? @map("notifications_paused_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  refreshTokens          RefreshToken[]
  authTokens             AuthToken[]
  pushSubscriptions      PushSubscription[]
  createdBands           Band[]    @relation("BandCreatedBy")
  reviewedBands          Band[]    @relation("BandReviewedBy")
  createdVenues          Venue[]   @relation("VenueCreatedBy")
  reviewedVenues         Venue[]   @relation("VenueReviewedBy")
  createdEvents          Event[]   @relation("EventCreatedBy")
  reviewedEvents         Event[]   @relation("EventReviewedBy")
  likes                  Like[]
  bookmarks              Bookmark[]
  reminders              Reminder[]
  moderationLogEntries   ModerationLog[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  familyId    String    @map("family_id")
  replacedBy  String?   @map("replaced_by")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuthToken {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at")
  usedAt     DateTime?     @map("used_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model PushSubscription {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  endpoint    String    @unique
  p256dhKey   String    @map("p256dh_key")
  authKey     String    @map("auth_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model SystemSetting {
  key        String   @id
  value      Json
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("system_settings")
}

// ---------------------------------------------------------
// GÉNEROS Y BANDAS
// ---------------------------------------------------------

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique

  bands BandGenre[]

  @@map("genres")
}

model Band {
  id               String            @id @default(uuid())
  name             String
  slug             String
  country          String?
  formedYear       Int?              @map("formed_year")
  bio              String?
  isTribute        Boolean           @default(false) @map("is_tribute")
  tributeOfBandId  String?           @map("tribute_of_band_id")
  sourceType       ContentSourceType @default(manual) @map("source_type")
  status           ModerationStatus  @default(pendiente)
  createdBy        String?           @map("created_by")
  reviewedBy       String?           @map("reviewed_by")
  reviewedAt       DateTime?         @map("reviewed_at")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tributeOf        Band?             @relation("TributeOf", fields: [tributeOfBandId], references: [id])
  tributeBands      Band[]           @relation("TributeOf")
  creator          User?             @relation("BandCreatedBy", fields: [createdBy], references: [id])
  reviewer         User?             @relation("BandReviewedBy", fields: [reviewedBy], references: [id])
  externalIds      BandExternalId[]
  genres           BandGenre[]
  eventBands       EventBand[]

  @@map("bands")
}

model BandExternalId {
  id            String         @id @default(uuid())
  bandId        String         @map("band_id")
  source        ExternalSource
  externalId    String         @map("external_id")
  url           String?
  lastSyncedAt  DateTime?      @map("last_synced_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@map("band_external_ids")
}

model BandGenre {
  bandId  String @map("band_id")
  genreId Int    @map("genre_id")

  band  Band  @relation(fields: [bandId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bandId, genreId])
  @@map("band_genres")
}

// ---------------------------------------------------------
// VENUES Y ESCENARIOS
// ---------------------------------------------------------

model Venue {
  id            String            @id @default(uuid())
  name          String
  slug          String
  address       String?
  city          String
  stateRegion   String?           @map("state_region")
  country       String
  latitude      Float?
  longitude     Float?
  capacity      Int?
  timezone      String            @default("UTC")
  sourceType    ContentSourceType @default(manual) @map("source_type")
  status        ModerationStatus  @default(pendiente)
  createdBy     String?           @map("created_by")
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  deletedAt     DateTime?         @map("deleted_at")
  deletedBy     String?           @map("deleted_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  creator  User?   @relation("VenueCreatedBy", fields: [createdBy], references: [id])
  reviewer User?   @relation("VenueReviewedBy", fields: [reviewedBy], references: [id])
  stages   Stage[]
  events   Event[]

  @@map("venues")
}

model Stage {
  id        String   @id @default(uuid())
  venueId   String   @map("venue_id")
  name      String
  latitude  Float?
  longitude Float?
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at")

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventStages  EventStage[]

  @@unique([venueId, name])
  @@map("stages")
}

// ---------------------------------------------------------
// EVENTOS
// ---------------------------------------------------------

model Event {
  id           String            @id @default(uuid())
  name         String
  slug         String
  type         EventType         @default(concierto)
  description  String?
  startDate    DateTime          @map("start_date") @db.Date
  endDate      DateTime?         @map("end_date") @db.Date
  venueId      String            @map("venue_id")
  sourceType   ContentSourceType @default(manual) @map("source_type")
  status       ModerationStatus  @default(pendiente)
  createdBy    String?           @map("created_by")
  reviewedBy   String?           @map("reviewed_by")
  reviewedAt   DateTime?         @map("reviewed_at")
  deletedAt    DateTime?         @map("deleted_at")
  deletedBy    String?           @map("deleted_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  venue         Venue             @relation(fields: [venueId], references: [id])
  creator       User?             @relation("EventCreatedBy", fields: [createdBy], references: [id])
  reviewer      User?             @relation("EventReviewedBy", fields: [reviewedBy], references: [id])
  externalIds   EventExternalId[]
  eventStages   EventStage[]
  eventBands    EventBand[]
  ticketInfo    TicketInfo?
  likes         Like[]
  bookmarks     Bookmark[]
  reminders     Reminder[]

  @@map("events")
}

model EventExternalId {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  source        ExternalSource
  externalId    String         @map("external_id")
  url           String?
  lastSyncedAt  DateTime?      @map("last_synced_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@map("event_external_ids")
}

model EventStage {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  stageId      String   @map("stage_id")
  displayName  String?  @map("display_name")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage      Stage       @relation(fields: [stageId], references: [id])
  eventBands EventBand[]

  @@unique([eventId, stageId])
  @@map("event_stages")
}

model EventBand {
  id             String    @id @default(uuid())
  eventId        String    @map("event_id")
  bandId         String    @map("band_id")
  eventStageId   String?   @map("event_stage_id")
  startTime      DateTime? @map("start_time")
  endTime        DateTime? @map("end_time")
  billingOrder   Int?      @map("billing_order")
  createdAt      DateTime  @default(now()) @map("created_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  band       Band        @relation(fields: [bandId], references: [id])
  eventStage EventStage? @relation(fields: [eventStageId], references: [id])

  // Nota: la restricción EXCLUDE (choque de horario por escenario) vive a nivel
  // de base de datos vía migración SQL manual — Prisma no expresa EXCLUDE
  // constraints nativamente. Ver prisma/migrations/.../migration.sql.
  @@map("event_bands")
}

model TicketInfo {
  eventId      String    @id @map("event_id")
  priceMin     Float?    @map("price_min")
  priceMax     Float?    @map("price_max")
  currency     String    @default("MXN")
  externalUrl  String?   @map("external_url")
  onSaleDate   DateTime? @map("on_sale_date") @db.Date
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("ticket_info")
}

// ---------------------------------------------------------
// INTERACCIÓN SOCIAL Y RECORDATORIOS
// ---------------------------------------------------------

model Like {
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("likes")
}

model Bookmark {
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("bookmarks")
}

model Reminder {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  eventId       String          @map("event_id")
  channel       ReminderChannel
  remindBefore  String          @default("1 day") @map("remind_before") // Postgres INTERVAL
  sentAt        DateTime?       @map("sent_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, channel, remindBefore])
  @@map("reminders")
}

// ---------------------------------------------------------
// MODERACIÓN Y ETL
// ---------------------------------------------------------

model ModerationLog {
  id          String               @id @default(uuid())
  entityType  ModerationEntityType @map("entity_type")
  entityId    String               @map("entity_id")
  action      ModerationAction
  reason      String?
  reviewerId  String               @map("reviewer_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  reviewer User @relation(fields: [reviewerId], references: [id])

  @@map("moderation_log")
}

model EtlRun {
  id                String        @id @default(uuid())
  source            ExternalSource
  startedAt         DateTime      @default(now()) @map("started_at")
  finishedAt        DateTime?     @map("finished_at")
  status            EtlRunStatus?
  recordsProcessed  Int           @default(0) @map("records_processed")
  recordsCreated    Int           @default(0) @map("records_created")
  recordsMatched    Int           @default(0) @map("records_matched")
  errorLog          String?       @map("error_log")

  @@map("etl_runs")
}
